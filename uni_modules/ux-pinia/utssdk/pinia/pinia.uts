/**
 * Pinia 实例与插件体系实现（≙ createPinia / setActivePinia / getActivePinia）
 *
 * 实现函数一律 Impl 后缀（入口 index.uts 内联声明对外同名 API，
 * 避免同名 top-level 符号触发 Kotlin 导出符号静默重整）。
 *
 * UTS 约束：插件不能返回对象合并进 store（禁止动态注入属性），PiniaPlugin
 * 返回 void，插件逻辑通过 PiniaPluginContext 完成（unix-storage 同款约束）。
 */
import type { PiniaPlugin, PiniaPluginContext } from '../interface.uts'

/**
 * Pinia 实例。
 * 说明：uni-app x 应用无多实例隔离场景，store 全局唯一注册表（差异表已注明）；
 * Pinia 实例承载插件列表与 active 标记。
 */
export class Pinia {
	private plugins: Array<PiniaPlugin> = new Array<PiniaPlugin>()

	/** 注册插件（链式） */
	use(plugin: PiniaPlugin): Pinia {
		this.plugins.push(plugin)
		return this
	}

	/** app.use(pinia) 入口：登记为 active 实例（P8 裁决：仅 Web 端可靠，原生端用顶层 setActivePinia） */
	install(app: any): void {
		setActivePiniaImpl(this)
		console.log('[unix-pinia] pinia install（app.use 挂载成功）')
	}

	/** 供 defineStore 在 store 创建后调度插件 */
	getPlugins(): Array<PiniaPlugin> {
		return this.plugins
	}
}

// 模块级 active 实例（UTS 顶层变量 = 静态成员）
let currentActive: Pinia | null = null

/** 创建 Pinia 实例（实现；对外由入口 createPinia 内联声明） */
export function createPiniaImpl(): Pinia {
	return new Pinia()
}

export function setActivePiniaImpl(pinia: Pinia | null): void {
	currentActive = pinia
}

export function getActivePiniaImpl(): Pinia | null {
	return currentActive
}
