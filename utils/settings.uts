/**
 * 全局配置（对标 vue-admin-template src/settings.js）
 *
 * 全局唯一配置源：servers/http.uts 等消费方从这里读取，不各自散落常量。
 */

/** 应用配置结构 */
export type AppSettings = {
	/** 应用名（登录页标题等） */
	appName: string
	/** 后端服务地址（占位，按实际环境替换） */
	baseURL: string
	/** 请求超时（毫秒） */
	timeout: number
}

export const settings: AppSettings = {
	appName: 'unix-architecture',
	baseURL: 'http://127.0.0.1:3210',
	timeout: 15000
}
