/**
 * 实例 API 顶层函数（实现层）
 *
 * 0.2.0 class 式架构下的职责收缩：$patch / $reset / $subscribe / $onAction / $save
 * 已是 PiniaStoreBase 实例方法，顶层仅保留跨实例的通用操作：
 * - dispose(store)：注销实例（≡ store.$dispose()，注册表移除）
 * - getStoreId(store)：反查 id（≡ store.$id，未登记返回空串）
 * （0.2.0 的顶层 patch(store, mutator) 已裁掉——reactive 架构下 $patch(partial)
 *   与直接调用 action 等价且类型安全）
 *
 * Kotlin 泛型擦除红线（error17）：泛型 T 进出 Map<string, any> 必须显式 as any。
 */
import { removeStore, storeIdMap } from './registry.uts'

/** ≙ store.$dispose()：注销实例；已定义 id 保留，下次 useStore 重建 */
export function disposeImpl<T>(store: T): void {
	removeStore(store as any)
}

/** ≙ store.$id：反查 store id；未登记返回空串 */
export function getStoreIdImpl<T>(store: T): string {
	const id: string | null = storeIdMap.get(store as any)
	return id != null ? id : ''
}
