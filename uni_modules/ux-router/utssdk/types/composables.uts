/**
 * 组合式 API 相关类型定义
 */
import type { ComputedRef, Ref } from 'vue'
import type { RouteLocation, RouteLocationRaw } from './route'

/** useLink 选项 */
export type UseLinkOptions = {
	/** 目标路由位置 */
	to: RouteLocationRaw
	/** 是否使用替换导航（replace）而非 push */
	replace?: boolean
	/** 是否使用 relaunch 导航 */
	relaunch?: boolean
}

/** useLink 返回值 */
export type UseLinkReturn = {
	/** 返回的目标路由位置 */
	route: ComputedRef<RouteLocation>
	/** 是否为当前激活路由（路径前缀匹配） */
	isActive: ComputedRef<boolean>
	/** 是否为当前精确激活路由（完整路径匹配） */
	isExactActive: ComputedRef<boolean>
	/** 响应式目标 href（等于 route.fullPath） */
	href: ComputedRef<string>
	/** 执行导航的函数 */
	navigate: () => Promise<RouteLocation | null>
}