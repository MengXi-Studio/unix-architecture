<template>
  <view class="page">
    <view class="logo-box">
      <AppLogo />
    </view>
    <text class="title">{{ title }}</text>
    <text class="welcome" v-if="name.length > 0">欢迎，{{ name }}</text>
    <view class="logout-btn-box">
      <m-button type="danger" plain hairline block @click="handleLogout">退出登录</m-button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { useRouter } from '@/uni_modules/ux-router/utssdk/index.uts'
import { storeToRefs } from '@/uni_modules/ux-pinia'
import { useUserStore } from '@/stores/index.uts'
import { showModalAsync } from '@/uni_modules/ux-utils'

defineUniPage({
  name: 'index',
  title: '首页'
})

const userStore = useUserStore()
const { name } = storeToRefs(userStore)
const router = useRouter()
const title = ref('Hello')

const handleLogout = (): void => {
  showModalAsync({
    title: '退出登录',
    content: '确定要退出当前账号吗？'
  })
    .then(res => {
      if (res.confirm) {
        userStore
          .logoutAction()
          .then(() => {
            router.relaunch('/pages/login/login')
          })
          .catch(_e => {
            console.error('[index] logout 异常')
          })
      }
    })
    .catch(_e => {
      console.error('[index] modal 异常')
    })
}
</script>

<style>
.page {
  flex: 1;
}

.logo-box {
  align-items: center;
  margin-top: 100px;
  margin-bottom: 25px;
}

.title {
  font-size: 18px;
  color: #8f8f94;
  text-align: center;
}

.welcome {
  font-size: 14px;
  color: #303133;
  text-align: center;
  margin-top: 12px;
}

.logout-btn-box {
  margin: 40px 40px 0 40px;
}
</style>
