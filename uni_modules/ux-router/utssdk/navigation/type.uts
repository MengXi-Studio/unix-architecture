/**
 * 导航选项类型
 */
import type { RouteMeta } from '../types'

/** 内部导航选项（由 router 解析后交给 uni 适配层） */
export type UniNavigationOptions = {
	/** 规范化页面路径 */
	path: string
	/** 查询参数 */
	query: Map<string, string>
	/** 是否为 tabBar 页面 */
	isTab: boolean
	/** 元信息（保留，供后续扩展） */
	meta: RouteMeta
	/** 窗口过渡动画类型（对齐 uni-app x animationType，AnimationPlugin 注入） */
	animationType?: string
	/** 窗口过渡动画持续时间（ms） */
	animationDuration?: number
}

/** 导航动画参数（透传给 uni.* 动画选项的裁剪视图） */
export type UniAnimation = {
	type?: string
	duration?: number
}