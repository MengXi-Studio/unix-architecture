/**
 * 用户域接口模块（api 层，按领域拆分；对标社区流行脚手架 src/api/*.ts）
 *
 * 薄封装原则：仅做请求转发与路径收敛，不写业务逻辑；
 * 响应统一以 UTSJSONObject 承载，字段协议由业务后端约定
 * （对齐 vue-admin-template mock 协议：login → { token }，info → { name, avatar }）。
 */
import { request } from '@/uni_modules/mx-request'
import type { ResponseResult } from '@/uni_modules/mx-request'

/** 登录：返回 token */
export function login(username: string, password: string): Promise<ResponseResult<UTSJSONObject>> {
	return request<UTSJSONObject>({
		url: '/user/login',
		method: 'POST',
		data: { username: username, password: password } as UTSJSONObject
	})
}

/** 获取用户信息：返回 name / avatar */
export function getInfo(): Promise<ResponseResult<UTSJSONObject>> {
	return request<UTSJSONObject>({
		url: '/user/info',
		method: 'GET'
	})
}

/** 退出登录 */
export function logout(): Promise<ResponseResult<UTSJSONObject>> {
	return request<UTSJSONObject>({
		url: '/user/logout',
		method: 'POST'
	})
}
