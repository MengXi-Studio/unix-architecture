<template>
	<view class="router-link" @click="onClick">
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
import { useLink } from '../composables/index.uts'

/**
 * RouterLink 组件（uni-app x · script setup 语法糖）
 *
 * 适配式 vue-router RouterLink：基于 useLink 提供点击导航。
 * 因 uni-app x 静态页面模型无页内渲染占位，本组件仅承担"可交互导航入口"角色。
 */

// 声明属性（setup 语法糖下使用 defineProps）
const props = defineProps({
	to: { type: String, default: '' },
	replace: { type: Boolean, default: false },
	relaunch: { type: Boolean, default: false }
})

// useLink 派生导航能力（响应式）
const link = useLink({ to: props.to, replace: props.replace, relaunch: props.relaunch })

// 模板可绑定的事件处理函数（setup 顶层声明会自动暴露给模板）
const onClick = () => {
	try {
		link.navigate()
	} catch (e) {
		// 导航失败由路由器 onError / 调用方处理
	}
}
</script>

<style>
.router-link {
	flex-direction: column;
}
</style>