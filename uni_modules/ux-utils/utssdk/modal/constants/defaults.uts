/**
 * modal 库内置默认值常量（仅供内部归一化回退使用）
 *
 * 命名红线（v0.8.1）：插件内所有 .uts 同 Kotlin package，与入口
 * index.uts 对外常量（DEFAULT_*）同名会触发符号静默重整（__1），
 * 故内部常量一律 BUILTIN_ 前缀，值须与入口内联字面量保持一致。
 */

/** 内置默认确认按钮文案 */
export const BUILTIN_CONFIRM_TEXT: string = '确定'

/** 内置默认取消按钮文案 */
export const BUILTIN_CANCEL_TEXT: string = '取消'

/** 内置默认确认按钮颜色（取 Web 默认，中性蓝） */
export const BUILTIN_CONFIRM_COLOR: string = '#007aff'

/** 内置默认取消按钮颜色 */
export const BUILTIN_CANCEL_COLOR: string = '#000000'

/**
 * 内置内容滚动阈值（百分比）：内容实测高度超过屏高的该百分比时才限高滚动，
 * 短内容不出现滚动条（对齐原生体验）。v0.2.0 砍掉对外可配置参数，仅保留内置行为。
 */
export const BUILTIN_MAX_CONTENT_HEIGHT_PERCENT: number = 60
