/**
 * 用户域 DTO 定义（api/types/ 目录，api 域类型唯一事实源）
 *
 * 归属标准：后端协议类型由 api 层权威定义，store / 页面 / 守卫经
 * api/types.uts 聚合出口消费；模块私有契约（如 config 的 AppSettings /
 * store 的 UserStore）保持就近定义，不收拢至此。
 *
 * 还原路径说明：mx-request 的 request<T> 泛型仅为静态标注（运行时 data 为
 * UTSJSONObject），故由 api 层经 JSON.parse<T>(JSON.stringify(data)) 官方
 * 路径还原为本目录 DTO 后再上抛，store / 页面不接触裸 JSON。
 */

/** 登录响应（后端协议：{ token }） */
export type LoginResult = {
  token: string
}

/** 用户信息（后端协议：{ name, avatar }） */
export type UserInfo = {
  name: string
  avatar: string
}
