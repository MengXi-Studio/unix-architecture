/**
 * EventsPlugin - 页面间定向通信插件
 *
 * 补齐 uni-app x 的 events（页面间通信）能力：
 * - 打开方 push 时携带 `events` 监听表（对齐官方 events 语义，监听被打开页回传数据）
 * - 内部为每次导航创建独立 EventChannel，通道 key 经 URL 查询串（__evt__）跨页桥接
 * - 被打开页通过 useOpenerEventChannel() 获得通道：emit 回传数据 / on 接收打开方推送
 *
 * 底层使用自研事件总线（不依赖官方 uni.$on），避开官方版本门槛。
 *
 * 注册方式：
 * ```ts
 * import { createRouter, EventsPlugin } from '@meng-xi/unix-router'
 * const router = createRouter({ routes, plugins: [new EventsPlugin()] })
 * ```
 *
 * class 实现：非蒸汽（Kotlin/Swift）端对象字面量含方法会被推断为 UTSJSONObject。
 */
import type { PluginContext, RouterOptions, RouteLocationRaw } from '../../types'
import { RouterPlugin } from '../../types'
import { pickEvents, EVT_QUERY_KEY, CHANNEL_DATA_KEY, setCurrentChannelKey } from './types'
import { channelManager } from './channel'
import type { EventsMap } from './types'

export { eventBus, UniEventBus, type EventCallback } from './bus'
export { EventChannel, channelManager } from './channel'
export { pickEvents, EVT_QUERY_KEY, CHANNEL_DATA_KEY, setCurrentChannelKey, getCurrentChannelKey, type EventsMap } from './types'

/**
 * EventsPlugin - 页面间定向通信插件
 * 需注册后 push 携带的 events 才生效；未注册时携带 events 的导航仍正常执行（events 被忽略）。
 */
export class EventsPlugin extends RouterPlugin {
	constructor() {
		super()
		this.name = 'events'
	}

	override install(context: PluginContext, options: RouterOptions): void {
		// 1. resolve 后：检测 events，创建通道并把监听表注册进通道
		context.onAfterResolve((enrichedLocation: RouteLocationRaw, pluginData) => {
			const events: EventsMap | null = pickEvents(enrichedLocation)
			if (events === null) {
				return
			}
			const key = channelManager.create()
			const channel = channelManager.get(key)
			if (channel !== null) {
				events.forEach((fn, eventName) => {
					channel.on(eventName, fn)
				})
			}
			pluginData.set(CHANNEL_DATA_KEY, key)
		})

		// 2. prepare：把通道 key 注入导航 URL 查询串（跨页桥接）
		context.onPrepareNavigation(ctx => {
			const key = ctx.pluginData.get(CHANNEL_DATA_KEY)
			if (key !== null) {
				ctx.query.set(EVT_QUERY_KEY, key as string)
			}
		})

		// 3. routeSync：被打开页从 URL 查询串读回通道 key，暴露给 useOpenerEventChannel
		context.onRouteSync((query, params) => {
			const key = query.get(EVT_QUERY_KEY)
			if (key !== null && key.length > 0) {
				setCurrentChannelKey(key)
			} else {
				// 当前页未携带通道时清空内存 key，避免上次导航的通道 key 残留导致误用
				setCurrentChannelKey(null)
			}
			// 内部 key 不暴露给用户 query（与 __params__ 一致）
			query.delete(EVT_QUERY_KEY)
		})

		// 4. abort：导航中止/失败时清理本次通道（页面正常进栈时通道保留，供回传与返回后继续通信）
		context.onNavigationAbort(pluginData => {
			const key = pluginData.get(CHANNEL_DATA_KEY)
			if (key !== null) {
				channelManager.remove(key as string)
			}
		})
	}
}