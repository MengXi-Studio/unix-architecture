import { createSSRApp } from 'vue'
import App from './App.uvue'
import router from './router/index.uts'
import { initRequest } from '@/utils/request.uts'
import { setupPermission } from './router/permission.uts'

export function createApp() {
  const app = createSSRApp(App)

  app.use(router)
  initRequest()
  setupPermission()

  return {
    app
  }
}
