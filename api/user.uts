/**
 * 用户域接口模块（api 层，按领域拆分；对标社区流行脚手架 src/api/*.ts）
 *
 * 薄封装原则：仅做请求转发、路径收敛与 DTO 还原，不写业务逻辑；
 * DTO 类型定义于 api/types/api.uts（经 api/types.uts 聚合出口消费），
 * 此处逐调用点以具体类型内联还原（JSON.parse<T> 泛型经二次封装会在 Kotlin 端触发泛型擦除，勿提取公共泛型包装）。
 */
import { request } from '@/uni_modules/mx-request'
import type { LoginResult, UserInfo } from './types.uts'

/** 登录：返回 token */
export function login(username: string, password: string): Promise<LoginResult> {
  return request<UTSJSONObject>({
    url: '/user/login',
    method: 'POST',
    data: { username: username, password: password } as UTSJSONObject
  }).then((res): LoginResult => {
    const dto = JSON.parse<LoginResult>(JSON.stringify(res.data))

    if (dto == null) {
      throw new Error('[api] login 响应解析失败')
    }

    return dto
  })
}

/** 获取用户信息：返回 name / avatar */
export function getInfo(): Promise<UserInfo> {
  return request<UTSJSONObject>({
    url: '/user/info',
    method: 'GET'
  }).then((res): UserInfo => {
    const dto = JSON.parse<UserInfo>(JSON.stringify(res.data))

    if (dto == null) {
      throw new Error('[api] getInfo 响应解析失败')
    }

    return dto
  })
}

/** 退出登录（无业务数据） */
export function logout(): Promise<void> {
  return request<UTSJSONObject>({
    url: '/user/logout',
    method: 'POST'
  }).then((_res): void => {})
}
