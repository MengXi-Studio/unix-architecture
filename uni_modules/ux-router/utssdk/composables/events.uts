/**
 * useOpenerEventChannel 组合式 API
 *
 * 被打开页获取与「打开方」之间的定向通信通道：
 * - emit(eventName, ...args)：向打开方回传数据（触发打开方 events 中注册的同名监听器）
 * - on / once / off：监听打开方推送的数据（打开方通过 channel.emit 推送）
 *
 * 需要创建路由器时注册 EventsPlugin，且本页是被携带 events 的导航打开的
 * （即本页 URL 查询串中含 __evt__ 通道 key）；否则返回 null。
 */
import type { EventChannel } from '../plugins/events/channel'
import { channelManager } from '../plugins/events/channel'
import { getCurrentChannelKey, getCurrentPageEventKey } from '../plugins/events/types'

/**
 * 获取当前页打开的页面间通信通道（无通道时返回 null）
 * @returns EventChannel 实例（on/once/off/emit），或 null
 */
export function useOpenerEventChannel(): EventChannel | null {
	// 优先取路由同步写入的内存 key；
	// 页面 onShow 早于路由同步（onRouteSync）时为 null，按当前页 URL（__evt__）兜底读取
	let key = getCurrentChannelKey()
	if (key === null) {
		key = getCurrentPageEventKey()
	}
	if (key === null) {
		return null
	}
	return channelManager.get(key)
}