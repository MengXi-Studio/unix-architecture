/**
 * 导航分发器
 *
 * 根据目标是否为 tabBar 页面（meta.isTab）在 uni.* 各导航 API 间分发：
 * - push(normal) → uni.navigateTo；push(tab) → uni.switchTab
 * - replace(normal) → uni.redirectTo；replace(tab) → uni.switchTab
 * - relaunch(normal) → uni.reLaunch；relaunch(tab) → uni.switchTab
 * - back → uni.navigateBack
 */
import type { UniNavigationOptions, UniAnimation } from './type'
import { uniNavigateTo, uniSwitchTab, uniRedirectTo, uniReLaunch, uniNavigateBack } from './helpers/uni-api'

/** 从 UniNavigationOptions 提取动画裁剪视图（无动画时返回 null） */
function toUniAnimation(options: UniNavigationOptions): UniAnimation | null {
	// H5 端可选字段缺省为 undefined（非 null），统一归一化后判断
	const animType: string | null = options.animationType ?? null
	if (animType === null || animType.length === 0) {
		return null
	}
	return {
		type: animType,
		duration: options.animationDuration ?? null
	}
}

/**
 * 执行前进导航（push）
 */
export function navigateTo(options: UniNavigationOptions): Promise<void> {
	if (options.isTab) {
		return uniSwitchTab(options.path)
	}
	return uniNavigateTo(options.path, options.query, toUniAnimation(options))
}

/**
 * 执行替换导航（replace）
 */
export function replaceTo(options: UniNavigationOptions): Promise<void> {
	if (options.isTab) {
		return uniSwitchTab(options.path)
	}
	return uniRedirectTo(options.path, options.query, toUniAnimation(options))
}

/**
 * 执行重启动导航（relaunch）
 */
export function relaunchTo(options: UniNavigationOptions): Promise<void> {
	if (options.isTab) {
		return uniSwitchTab(options.path)
	}
	return uniReLaunch(options.path, options.query, toUniAnimation(options))
}

/**
 * 执行返回导航（back）
 * @param delta - 返回层级
 * @param anim - 窗口关闭动画（AnimationPlugin 注入；null 时不携带动画参数）
 */
export function goBack(delta: number, anim: UniAnimation | null = null): Promise<void> {
	return uniNavigateBack(delta, anim)
}