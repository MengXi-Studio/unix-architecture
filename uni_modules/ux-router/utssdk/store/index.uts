/**
 * 内部运行时单例
 *
 * 供组合式 API（useRoute / useRouter）在非 provide/inject 作用下或跨页读取
 * 当前活跃路由与路由器。单路由应用下足够；如多实例请依赖 provide/inject。
 */
import { reactive } from 'vue'
import type { RouteLocation, Router } from '../types'

/** 空路由（占位） */
function emptyRoute(): RouteLocation {
	return {
		path: '/',
		name: null,
		meta: {},
		query: new Map(),
		params: new Map(),
		fullPath: '/',
		hash: '',
		matched: []
	}
}

/**
 * 全局响应式当前路由（reactive 对象，脚本/模板中可直接访问字段）
 * uni-app x 官方推荐用全局 reactive 变量做跨页响应式状态
 */
export const currentRoute: RouteLocation = reactive<RouteLocation>(emptyRoute())

/** 全局活跃路由器 */
let globalRouter: Router | null = null

/**
 * 更新全局当前路由（按字段更新以保持 reactive 对象的响应性）
 */
export function setGlobalCurrentRoute(to: RouteLocation): void {
	currentRoute.path = to.path
	currentRoute.name = to.name
	currentRoute.meta = to.meta
	currentRoute.query = to.query
	currentRoute.params = to.params
	currentRoute.fullPath = to.fullPath
	currentRoute.hash = to.hash
	currentRoute.matched = to.matched
}

/**
 * 设置全局活跃路由器（install 时调用）
 */
export function setActiveGlobalRouter(router: Router | null): void {
	globalRouter = router
}

/**
 * 获取全局活跃路由器
 */
export function activeGlobalRouter(): Router | null {
	return globalRouter
}