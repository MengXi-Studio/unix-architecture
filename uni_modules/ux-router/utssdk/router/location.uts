/**
 * 路由位置比较工具
 */
import type { RouteConfig, RouteLocation, RouteMeta } from '../types'

/**
 * 取路由表中首个声明 isTab 的路由路径（入口页兜底目标）。
 * 用于 back() 页面栈不足与拦截器根路径 reLaunch 的「回首页」兜底；无 tabBar 路由时返回 null。
 */
export function findFirstTabRoutePath(routes: RouteConfig[]): string | null {
	for (var i = 0; i < routes.length; i++) {
		const meta: RouteMeta | null = routes[i].meta
		if (meta != null && meta.isTab === true) {
			return routes[i].path
		}
	}
	return null
}

/**
 * 判断两个路由位置是否相同（路径 + 查询 + 参数 + hash 完全一致）
 * 用于重复导航检测（避免重复触发同一地址导航）。
 * 任一 query/params/hash 不同均视为不同导航，允许以新参数重入当前页。
 */
export function isSameRouteLocation(a: RouteLocation, b: RouteLocation): boolean {
	if (a.path !== b.path) {
		return false
	}
	if (!sameMap(a.query, b.query)) {
		return false
	}
	if (!sameMap(a.params, b.params)) {
		return false
	}
	return a.hash === b.hash
}

/** 比较两个 Map 是否完全一致（键值一一对应） */
function sameMap(a: Map<string, string>, b: Map<string, string>): boolean {
	if (a.size !== b.size) {
		return false
	}
	let same = true
	a.forEach((value, key) => {
		if (b.get(key) !== value) {
			same = false
		}
	})
	return same
}